# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it's already in .gitignore).

# --- OpenAI -----------------------------------------------------------------
# Required for the /api/round/ask endpoint (grounded yes/no/sometimes/unclear
# answers). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Session signing ----------------------------------------------------------
# Used to HMAC-sign the opaque round tokens that hold in-progress round state
# (see lib/session.ts). Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Supabase (optional) ------------------------------------------------------
# Optional: enables cross-device streak persistence and a global leaderboard.
# Create a free project at https://supabase.com, then run db/schema.sql in
# the SQL editor. Find these values under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key: server-only, NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google AdSense (optional) ------------------------------------------------
# Optional: shows a real ad unit in components/AdSlot.tsx once you have an
# approved AdSense account. Leave unset to show a dev placeholder instead.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your-adsense-client-id
